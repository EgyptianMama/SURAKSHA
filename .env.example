# 🔐 SURAKSHA Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# GROQ AI API
# ============================================
# Get your API key from: https://console.groq.com/keys
# Required for: AI chatbot, disaster simulation, quiz generation
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# EMAIL ALERTS (Gmail SMTP)
# ============================================
# Email account used to send disaster alerts
EMAIL_USER=your_email@gmail.com

# Gmail App Password (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
# Required for: Email alert system
EMAIL_PASS=your_gmail_app_password_here

# ============================================
# FIREBASE CLIENT SDK (Public - Safe to Expose)
# ============================================
# These are public identifiers for Firebase Client SDK
# Get from: Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# FIREBASE ADMIN SDK (Server-Side - Keep Secret!)
# ============================================
# Download service account JSON from Firebase Console > Project Settings > Service Accounts
# Option 1: Store the entire JSON as a single-line string (recommended for deployment)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
#
# Option 2: For local development, you can use Application Default Credentials
# Run: gcloud auth application-default login
# Then leave this blank and it will use your gcloud credentials
